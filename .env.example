# Copy to .env (root) — root .env is loaded by the server via dotenv.
# The web app reads VITE_* vars from apps/web/.env.

# === Supabase ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server only — never expose to browser

# === Quran Foundation ===
QF_CLIENT_ID=
QF_CLIENT_SECRET=             # server only
QF_AUTH_URL=https://oauth2.quran.foundation
QF_API_URL=https://apis.quran.foundation

# === Express ===
EXPRESS_PORT=3001
SESSION_SECRET=               # server only — generate with: openssl rand -base64 32
SERVER_BASE_URL=http://localhost:3001   # public URL of the server (Railway URL in prod)

# === Frontend (apps/web/.env) ===
# VITE_API_BASE_URL=http://localhost:3001
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
