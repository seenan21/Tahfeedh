{
  "name": "tahfeedh",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@tahfeedh/web",
    "dev:server": "npm run dev --workspace=@tahfeedh/server",
    "dev": "npm-run-all --parallel dev:web dev:server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:quran-data": "tsx scripts/build-quran-data.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
