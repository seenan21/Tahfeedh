{
  "name": "tahfeedh",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@tahfeedh/shared",
    "dev:shared": "npm run dev --workspace=@tahfeedh/shared",
    "dev:web": "npm run dev --workspace=@tahfeedh/web",
    "dev:server": "npm run dev --workspace=@tahfeedh/server",
    "predev": "npm run build:shared",
    "dev": "npm-run-all --parallel dev:shared dev:web dev:server",
    "build": "npm run build:shared && npm run build --workspace=@tahfeedh/server && npm run build:web",
    "build:server": "npm run build:shared && npm run build --workspace=@tahfeedh/server",
    "build:web": "npm run build:shared && npm run build:assets && npm run build --workspace=@tahfeedh/web",
    "build:assets": "npm run build:quran-data && npm run download:fonts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:quran-data": "tsx scripts/build-quran-data.ts",
    "build:quran-index": "tsx scripts/build-quran-index.ts",
    "download:fonts": "tsx scripts/download-fonts.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
